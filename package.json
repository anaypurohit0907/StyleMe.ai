{
  "name": "styleme",
  "private": true,
  "version": "0.1.0",
  "description": "StyleMe.ai — first-principles personal outfit engine",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "packageManager": "npm@11.9.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "worker:dev": "npm run dev -w @styleme/worker",
    "worker:deploy": "npm run deploy -w @styleme/worker",
    "mobile:start": "npm run start -w @styleme/mobile"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  }
}
