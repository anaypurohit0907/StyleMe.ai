{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "styleme-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Copy to .dev.vars for local dev (never commit):
    //   JWT_SECRET=<32+ chars random>
    //   GEMINI_API_KEY= (optional, phase 6 tone rewrites)
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "styleme",
      "database_id": "7d92e3e6-58f1-42e4-91d6-91b5e3b23c71"
    }
  ],
  // R2 is optional: enable it in the Cloudflare dashboard, create the bucket,
  // then uncomment this block. Photos stay on-device by default anyway.
  // "r2_buckets": [
  //   {
  //     "binding": "PHOTOS",
  //     "bucket_name": "styleme-photos"
  //   }
  // ]
}
