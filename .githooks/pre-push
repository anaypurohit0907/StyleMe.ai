#!/usr/bin/env bash
# Shared-box pre-push release gate (T-070).
#
# Code pushes run the CI pair + typecheck + mobile lint locally. Pushes that
# only touch coordination/docs skip instantly, so agents keep their fast path.
# Bypass for a genuine emergency only: `git push --no-verify`, then say why in
# agents/CHATBOARD.md.
set -euo pipefail

zero=0000000000000000000000000000000000000000
code_changed=0

while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # branch deletion

  if git show-ref --verify --quiet "refs/remotes/origin/main"; then
    base="$(git merge-base origin/main "$local_sha" 2>/dev/null || true)"
  else
    base=""
  fi

  if [ -n "$base" ] && [ "$base" != "$local_sha" ]; then
    changed="$(git diff --name-only "$base".."$local_sha" || true)"
  else
    changed="$(git show --pretty=format: --name-only "$local_sha" || true)"
  fi

  if printf '%s\n' "$changed" | grep -qE '^(apps|packages|ml|scripts|\.github)/|^(package(-lock)?\.json|turbo\.json|tsconfig.*\.json)$'; then
    code_changed=1
  fi

  printf '%s\n' "$remote_ref" >/dev/null
done

if [ "$code_changed" -eq 0 ]; then
  exit 0
fi

echo "pre-push: code changed — running release gate (tests, typecheck, mobile lint)…"
npx turbo run test --filter=@styleme/engine --filter=@styleme/worker
npx turbo run typecheck --filter=@styleme/schema --filter=@styleme/engine \
  --filter=@styleme/worker --filter=@styleme/mobile
(cd apps/mobile && npx expo lint)
echo "pre-push: release gate passed."
